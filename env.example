# Připoj se na PostgreSQL databázi (Coolify ti databázi vytvoří a connection string vygeneruje)
DATABASE_URL="postgresql://user:password@localhost:5432/bar_pos"

# Tajný klíč pro podepisování přihlašovacích session cookies (vygeneruj si vlastní náhodný řetězec)
SESSION_SECRET="zmen-me-na-nahodny-dlouhy-retezec"

# Bankovní účet baru, na který se budou generovat QR platby (IBAN formát)
BAR_BANK_IBAN="CZ0000000000000000000000"
